# Copy to .env

# API keys (leave blank if unused)
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
GOOGLE_API_KEY=your-google-api-key

# Vertex AI (required by run6UpdateConfigs.sh for ADCo's .env)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global

# Postgres connection written into both baselines' DBConfig.yaml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Postgres paths (optional; used by initpgSQL.sh; defaults to /var/lib/postgresql/data and /usr/lib/postgresql/14/bin)
POSTGRES_DATA_DIR=/var/lib/postgresql/data
POSTGRES_BIN_DIR=/usr/lib/postgresql/14/bin

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# DB_Layer (Knob Tuning)
## Baseline
Baseline_POSTGRES_USER=postgres
Baseline_POSTGRES_PASSWORD=postgres
Baseline_POSTGRES_HOST=127.0.0.1
Baseline_POSTGRES_PORT=5432

## ADCo
ADCo_POSTGRES_USER=postgres
ADCo_POSTGRES_PASSWORD=postgres
ADCo_POSTGRES_HOST=127.0.0.1
ADCo_POSTGRES_PORT=5433

## AgentTune
AgentTune_POSTGRES_USER=postgres
AgentTune_POSTGRES_PASSWORD=postgres
AgentTune_POSTGRES_HOST=127.0.0.1
AgentTune_POSTGRES_PORT=5434
